{
  "name": "sec-forum-backend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "tsc",
    "start": "bun run src/index.ts",
    "db:migrate": "bun run src/db/migrate.ts",
    "db:push": "bunx drizzle-kit push",
    "db:generate": "bunx drizzle-kit generate",
    "db:studio": "bun run src/db/studio.ts",
    "db:seed": "bun run src/db/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.980.0",
    "@elysiajs/cors": "^1.1.0",
    "@elysiajs/jwt": "^1.0.0",
    "@elysiajs/swagger": "^1.0.0",
    "bcrypt": "^5.1.1",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.33.0",
    "elysia": "^1.4.19",
    "elysia-decorators": "^1.0.2",
    "postgres": "^3.4.4",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^20.16.0",
    "bun-types": "^1.3.5",
    "drizzle-kit": "^0.24.0",
    "typescript": "^5.6.2"
  }
}
