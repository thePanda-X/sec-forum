# ===========================================
# SEC-FORUM Environment Configuration
# ===========================================
# Copy this file to .env and update the values
# for your environment (development/production)
# ===========================================

# -----------------
# Environment
# -----------------
NODE_ENV=development

# -----------------
# PostgreSQL Database
# -----------------
POSTGRES_USER=secforum
POSTGRES_PASSWORD=your-secure-database-password
POSTGRES_DB=secforum
DB_PORT=5432

# Database URL (constructed from above, or override directly)
# For Docker: postgres://POSTGRES_USER:POSTGRES_PASSWORD@db:5432/POSTGRES_DB
# For local development: postgres://POSTGRES_USER:POSTGRES_PASSWORD@localhost:5432/POSTGRES_DB
DATABASE_URL=postgres://secforum:your-secure-database-password@localhost:5432/secforum

# -----------------
# Backend Configuration
# -----------------
PORT=3000
BACKEND_PORT=3000
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# -----------------
# Frontend Configuration
# -----------------
FRONTEND_PORT=3001
BACKEND_URL=http://localhost:3000

# -----------------
# Admin User Seeding
# -----------------
# These credentials will be used to create the initial admin user
# IMPORTANT: Change these values for production environments!
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123

# -----------------
# Logging
# -----------------
LOG_LEVEL=INFO
